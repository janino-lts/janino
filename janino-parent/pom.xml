<?xml version="1.0"?>

<project
  xmlns="http://maven.apache.org/POM/4.0.0"
  xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
  xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
  child.project.url.inherit.append.path="false"
>
  <modelVersion>4.0.0</modelVersion>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

    <!--
      JANINO retains backwards compatibility with JRE 8. "release" (as opposed to "source" and "target") also
      verifies that only JRE 8 APIs are used.
    -->
    <maven.compiler.release>8</maven.compiler.release>

    <!--
      Some tests verify the texts of compiler error messages, so the tests must run with an English locale.
    -->
    <test.locale.argLine>-Duser.language=en -Duser.country=US</test.locale.argLine>

    <!--
      The JVM arguments of the JaCoCo agent (profile "quality"); empty by default. The surefire configurations refer
      to it with "@{argLine}" (late replacement), because the agent sets it only when the tests are executed.
    -->
    <argLine></argLine>
  </properties>

  <artifactId>janino-parent</artifactId>

  <name>janino-parent</name>

  <groupId>io.github.janino-lts</groupId>
  <packaging>pom</packaging>
  <version>3.1.20-SNAPSHOT</version>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>junit</groupId>
        <artifactId>junit</artifactId>
        <version>4.13.1</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <developers>
    <developer>
      <id>aunkrig</id>
      <name>Arno Unkrig</name>
      <roles>
        <role>Despot</role>
        <role>Developer</role>
      </roles>
    </developer>
    <developer>
      <id>oontvo</id>
      <name>Vy Nguyen</name>
      <roles>
        <role>Despot</role>
        <role>Developer</role>
      </roles>
    </developer>
    <developer>
      <id>stefan-zobel</id>
      <name>Stefan Zobel</name>
      <url>https://github.com/stefan-zobel</url>
      <organization>janino-lts</organization>
      <organizationUrl>https://github.com/janino-lts</organizationUrl>
      <roles>
        <role>Maintainer</role>
        <role>Developer</role>
      </roles>
    </developer>
  </developers>

  <modules>
    <module>../commons-compiler</module>
    <module>../commons-compiler-jdk</module>
    <module>../janino</module>
    <module>../commons-compiler-tests</module>
  </modules>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <argLine>@{argLine} ${test.locale.argLine}</argLine>
        </configuration>
      </plugin>

      <plugin>
        <artifactId>maven-jar-plugin</artifactId>
        <version>3.0.2</version>
        <configuration>
          <archive>  

            <!-- This line is required, otherwise the maven-bundle-plugin doesn't add the OSGi lines. -->
            <manifestFile>${project.build.outputDirectory}/META-INF/MANIFEST.MF</manifestFile>
            <manifestEntries combine.children="append">
              <Automatic-Module-Name>${automaticModuleName}</Automatic-Module-Name>
            </manifestEntries>
          </archive> 
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.felix</groupId>
        <artifactId>maven-bundle-plugin</artifactId>
        <version>2.5.4</version>
        <extensions>true</extensions>
        <executions>
          <execution>
            <id>bundle-manifest</id>
            <phase>process-classes</phase>
            <goals><goal>manifest</goal></goals>   
          </execution>
        </executions>
        <configuration>
          <instructions>
            <!--
              Fixed rather than derived from the group ID, so that the symbolic names stay the same when the group ID
              changes (OSGi bundles refer to them, e.g. "Require-Bundle" in "janino/pom.xml").
            -->
            <Bundle-SymbolicName>org.codehaus.janino.${project.artifactId};singleton:=true</Bundle-SymbolicName>
            <Bundle-Name>${project.artifactId}</Bundle-Name>
            <Bundle-Version>${project.version}</Bundle-Version>
            <Bundle-License>https://spdx.org/licenses/BSD-3-Clause.html</Bundle-License>
            <Bundle-Description>Janino is a super-small, super-fast Java compiler.</Bundle-Description>
          </instructions>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-jarsigner-plugin</artifactId>
        <version>1.4</version>
        <executions>
          <execution>
            <id>sign</id>
            <goals>
              <goal>sign</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <keystore>../janino-parent/dummy-keystore</keystore>
          <alias>dummy</alias>
          <storepass>storepass</storepass>
          <keypass>keypass</keypass>
        </configuration>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-javadoc-plugin</artifactId>
        <version>3.11.2</version>
        <configuration>
          <quiet>true</quiet>
          <doclint>none</doclint>
        </configuration>
        <executions>
          <execution>
            <id>attach-javadocs</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>

          <!--
            The JAVADOC of all modules, for publication on the project website. Not bound to a phase; run it with
              mvn -f janino-parent/pom.xml install javadoc:aggregate@website-apidocs
            The result is in "janino-parent/target/reports/apidocs".
          -->
          <execution>
            <id>website-apidocs</id>
            <inherited>false</inherited>
            <goals>
              <goal>aggregate</goal>
            </goals>
            <configuration>
              <doctitle>JANINO ${project.version}</doctitle>
              <windowtitle>JANINO ${project.version}</windowtitle>
              <overview>${project.basedir}/../janino/src/main/javadoc/overview.html</overview>
              <notimestamp>true</notimestamp>

              <!-- Relative to "src/main/javadoc"; formats the ASCII art diagrams of the overview. -->
              <addStylesheets>
                <addStylesheet>additional-stylesheet.css</addStylesheet>
              </addStylesheets>
            </configuration>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-source-plugin</artifactId>
        <version>2.4</version>
        <executions>
          <execution>
            <id>attach-sources</id>
            <goals>
              <goal>jar</goal>
            </goals>
          </execution>
        </executions>
      </plugin>

      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>

            <!-- Suppress the warning "source value 8 is obsolete and will be removed in a future release". -->
            <arg>-Xlint:-options</arg>
          </compilerArgs>
        </configuration>
      </plugin>
    </plugins>

    <pluginManagement>
      <plugins>
        <plugin>
          <!-- Used by the workflows "Spark" and "Calcite" to determine the version of the candidate. -->
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-help-plugin</artifactId>
          <version>3.5.2</version>
        </plugin>
        <plugin>
          <groupId>org.apache.maven.plugins</groupId>
          <artifactId>maven-gpg-plugin</artifactId>
          <version>3.2.8</version>
          <executions>
            <execution>
              <id>sign-artifacts</id>
              <phase>verify</phase>
              <goals><goal>sign</goal></goals>
            </execution>
          </executions>
        </plugin>
      </plugins>
    </pluginManagement>
  </build>

  <profiles>

    <!--
      Assembles the project website (the files under "site/", plus the aggregated JAVADOC under "apidocs/") in
      "janino-parent/target/website":
        mvn -f janino-parent/pom.xml -P website
      To preview it locally, use the simple web server of the JDK (18+):
        jwebserver -d <absolute-path>/janino-parent/target/website -p 8000
      and open "http://localhost:8000/".
    -->
    <profile>
      <id>website</id>
      <properties>
        <skipTests>true</skipTests>
      </properties>
      <build>

        <!--
          The aggregated JAVADOC needs the compiled modules, so the "aggregate" goal must run after the reactor has
          been built, and thus cannot be bound to a lifecycle phase of this (parent) project. (Copying "site/", on the
          other hand, is bound to the "package" phase, see below.)
        -->
        <defaultGoal>clean install javadoc:aggregate@website-apidocs</defaultGoal>

        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <executions>
              <execution>
                <id>website-apidocs</id>
                <configuration>

                  <!-- The plugin appends "apidocs". -->
                  <outputDirectory>${project.build.directory}/website</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-resources-plugin</artifactId>
            <version>3.3.1</version>
            <executions>
              <execution>
                <id>website-site</id>
                <inherited>false</inherited>
                <phase>package</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <outputDirectory>${project.build.directory}/website</outputDirectory>
                  <resources>
                    <resource>
                      <directory>${project.basedir}/../site</directory>
                    </resource>
                  </resources>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Measures the test coverage (JaCoCo) and runs a static analysis (SpotBugs); reports only, never fails the build:
        mvn -f janino-parent/pom.xml -P quality verify
      The coverage report of all modules (without samples, command line tools and stand-ins for Java 8 / 9 APIs) is
      in "commons-compiler-tests/target/site/jacoco-aggregate", the SpotBugs reports are in "*/target/spotbugsXml.xml"
      and "*/target/reports/spotbugs.html"; the patterns that are intentional in JANINO are excluded through
      "spotbugs-exclude.xml".
    -->
    <profile>
      <id>quality</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <version>0.8.15</version>
            <executions>
              <execution>
                <id>prepare-agent</id>
                <goals>
                  <goal>prepare-agent</goal>
                </goals>
              </execution>
            </executions>
          </plugin>

          <plugin>
            <groupId>com.github.spotbugs</groupId>
            <artifactId>spotbugs-maven-plugin</artifactId>
            <version>4.10.4.1</version>
            <configuration>
              <effort>Max</effort>
              <xmlOutput>true</xmlOutput>
              <htmlOutput>true</htmlOutput>
              <excludeFilterFile>${project.basedir}/../janino-parent/spotbugs-exclude.xml</excludeFilterFile>
            </configuration>
            <executions>
              <execution>
                <id>spotbugs</id>
                <phase>verify</phase>
                <goals>
                  <goal>spotbugs</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Adds the module "janino-benchmarks", which compares the compile time of the current build with a baseline
      version of JANINO:
        mvn -f janino-parent/pom.xml -P benchmarks -DskipTests clean package
        java -jar janino-benchmarks/target/benchmarks.jar
      See "janino-benchmarks/src/main/java/org/codehaus/janino/benchmarks/package-info.java" for details.
    -->
    <profile>
      <id>benchmarks</id>
      <modules>
        <module>../janino-benchmarks</module>
      </modules>
    </profile>

    <!--
      JAVADOC of JDK 23 and later copies web fonts (about 4 MB) into every generated documentation; "no-fonts" leaves
      them out, so that the browser uses the fonts of the system, like with the JAVADOC of earlier JDKs. Activated
      automatically, because older JAVADOC versions do not know the option.
    -->
    <profile>
      <id>javadoc-no-fonts</id>
      <activation>
        <jdk>[23,)</jdk>
      </activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-javadoc-plugin</artifactId>
            <configuration>
              <additionalOptions>
                <additionalOption>--no-fonts</additionalOption>
              </additionalOptions>
            </configuration>
          </plugin>
        </plugins>
      </build>
    </profile>

    <!--
      Signs all artifacts with GPG (Maven Central requires that):
        mvn -f janino-parent/pom.xml -P have_gpg clean install -Dgpg.keyname=<fingerprint>
      Add "-Dgpg.executable=<path>/gpg.exe" if "gpg" is not on the path. The signatures ("*.asc") are in the "target"
      directories of the modules.
    -->
    <profile>
      <id>have_gpg</id>
      <build>
        <plugins>
          <plugin>
            <groupId>org.apache.maven.plugins</groupId>
            <artifactId>maven-gpg-plugin</artifactId>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <description>Janino is a super-small, super-fast Java compiler.</description>
  <url>https://janino-lts.github.io/janino/</url>
  <licenses>
    <license>
      <name>BSD-3-Clause</name>
      <url>https://spdx.org/licenses/BSD-3-Clause.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <!-- The modules inherit the URLs unchanged (by default, MAVEN would append their artifact IDs). -->
  <scm
    child.scm.connection.inherit.append.path="false"
    child.scm.developerConnection.inherit.append.path="false"
    child.scm.url.inherit.append.path="false"
  >
    <connection>scm:git:https://github.com/janino-lts/janino.git</connection>
    <developerConnection>scm:git:https://github.com/janino-lts/janino.git</developerConnection>
    <url>https://github.com/janino-lts/janino</url>
  </scm>
  <issueManagement>
    <system>GitHub</system>
    <url>https://github.com/janino-lts/janino/issues</url>
  </issueManagement>
</project>
