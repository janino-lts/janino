<?xml version="1.0"?>

<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>io.github.janino-lts</groupId>
    <artifactId>janino-parent</artifactId>
    <version>3.1.18</version>
    <relativePath>../janino-parent</relativePath>
  </parent>

  <artifactId>commons-compiler-tests</artifactId>

  <name>commons-compiler-tests</name>

  <properties>
    <automaticModuleName>org.codehaus.commons.compiler.tests</automaticModuleName>
  </properties>

  <dependencies>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.github.janino-lts</groupId>
      <artifactId>commons-compiler</artifactId>
      <version>${project.parent.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
    	<groupId>de.unkrig.jdisasm</groupId>
    	<artifactId>jdisasm</artifactId>
    	<version>1.0.6</version>
    	<scope>test</scope>
    </dependency>
  </dependencies>

  <profiles>

    <!--
      See profile "quality" in "janino-parent/pom.xml". The tests in this module exercise all modules, so the coverage
      report of all modules is created here. "report-aggregate" only covers the dependencies of this module, so the
      compiler implementations (which are otherwise only added to the test classpath, see below) are declared as
      dependencies. Code that is not part of the product (samples, command line tools, stand-ins for Java 8 / 9 APIs)
      is still built, but not counted.
    -->
    <profile>
      <id>quality</id>
      <dependencies>

        <!-- "report-aggregate" ignores dependencies with scope "test"; this module has no main code anyway. -->
        <dependency>
          <groupId>io.github.janino-lts</groupId>
          <artifactId>commons-compiler</artifactId>
          <version>${project.parent.version}</version>
        </dependency>
        <dependency>
          <groupId>io.github.janino-lts</groupId>
          <artifactId>janino</artifactId>
          <version>${project.parent.version}</version>
        </dependency>
        <dependency>
          <groupId>io.github.janino-lts</groupId>
          <artifactId>commons-compiler-jdk</artifactId>
          <version>${project.parent.version}</version>
        </dependency>
      </dependencies>
      <build>
        <plugins>
          <plugin>
            <groupId>org.jacoco</groupId>
            <artifactId>jacoco-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>report-aggregate</id>
                <phase>verify</phase>
                <goals>
                  <goal>report-aggregate</goal>
                </goals>
                <configuration>
                  <includeCurrentProject>true</includeCurrentProject>

                  <!-- Not part of the product: samples, command line tools, stand-ins for Java 8 / 9 APIs. -->
                  <excludes>
                    <exclude>org/codehaus/commons/compiler/samples/**</exclude>
                    <exclude>org/codehaus/janino/samples/**</exclude>
                    <exclude>org/codehaus/janino/tools/**</exclude>
                    <exclude>org/codehaus/commons/compiler/java8/**</exclude>
                    <exclude>org/codehaus/commons/compiler/java9/**</exclude>
                    <exclude>org/codehaus/commons/nullanalysis/**</exclude>
                  </excludes>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>

          <!--
            Some tests (e.g. "EvaluatorTest.test64kOperandStackHeight()") compile deeply nested code, which needs more
            than the default thread stack size on some platforms.
          -->
          <argLine>@{argLine} -Xss2m ${test.locale.argLine}</argLine>

          <!-- Add our compiler factories to the classpath. -->
          <additionalClasspathElements>

            <!-- No way to add *modules* to the classpath, only pathes: -->
            <additionalClasspathElement>${project.basedir}/../janino/target/classes</additionalClasspathElement>
            <additionalClasspathElement>${project.basedir}/../commons-compiler-jdk/target/classes</additionalClasspathElement>
          </additionalClasspathElements>
        </configuration>
        <executions>

          <!--
            Runs the source charset tests once more with a platform default charset that can not represent all
            characters, because the default charset is UTF-8 on most build machines.
          -->
          <execution>
            <id>non-utf8-default-charset</id>
            <goals>
              <goal>test</goal>
            </goals>
            <configuration>
              <test>SourceCharsetTest</test>
              <reportsDirectory>${project.build.directory}/surefire-reports-non-utf8</reportsDirectory>
              <argLine>@{argLine} -Xss2m ${test.locale.argLine} -Dfile.encoding=ISO-8859-1</argLine>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
  <packaging>jar</packaging>
  <description>Tests that use only the &quot;commons-compiler&quot; API and are thus applicable to ALL implementations.

NOTICE: This module is not a test for &quot;commons-compiler&quot;, but for a set of IMPLEMENTATIONS of &quot;commons-compiler&quot;!</description>
  <url>https://janino-lts.github.io/janino/</url>
</project>
